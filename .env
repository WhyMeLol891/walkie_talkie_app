# ----------------------------------------------------
# Walkie-Talkie Communication System Configuration
# ----------------------------------------------------

APP_NAME="Walkie Talkie PWA"
APP_ENV=local
APP_DEBUG=true

# Leave empty for auto-detection in subdirectories like /walkie_talkie_app
# Or set explicitly, e.g., APP_BASE_PATH=/walkie_talkie_app
APP_BASE_PATH=

# LAN URL used in the phone QR code
APP_PUBLIC_URL=http://10.237.144.125

# Secret key used for signing session HMAC-SHA256 tokens
SIGNAL_SECRET=wt_secret_salt_9f82a17cb64e2098d5c41e8f3b60

# Maximum number of participants allowed in a single channel (2-8)
SIGNAL_MAX_PEERS=8

# Push-To-Talk Floor speaking duration limit in milliseconds (default: 30000 = 30 seconds)
SIGNAL_FLOOR_TIMEOUT_MS=30000

# Peer heartbeat timeout in seconds (inactive peers are pruned after this duration)
PEER_HEARTBEAT_TIMEOUT_SEC=12

# Request size limits
SIGNAL_MAX_BODY=32768
SIGNAL_MAX_DATA=12288

# STUN Servers for WebRTC NAT Traversal (comma-separated)
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302"
